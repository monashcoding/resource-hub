# Host-built artefacts must never enter the image: node_modules here is compiled
# for macOS, and copying it over the Linux modules installed by `npm ci` breaks
# the build (esbuild/vite ship platform-specific binaries).
node_modules
dist

# Local-only files
.git
.gitignore
.env
.env.local
# Teaching-branch local-dev files: a database URL pointing at localhost and a
# fixture script have no business inside a production image.
.env.dev
docker-compose.dev.yml
scripts/
*.log
.DS_Store

# Docs and CI don't affect the runtime image.
README.md
CLAUDE.md
