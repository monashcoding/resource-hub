# Local development only. NOT a secret, and NOT used by any deployment.
#
# Points the app at the throwaway Postgres in docker-compose.dev.yml. That
# container publishes 5433 rather than 5432 so it can't collide with a Postgres
# you may already have installed.
#
# The npm scripts load this with Node's --env-file-if-exists, which means:
#   · it is optional — everything still runs if you delete this file
#   · a variable you set in your shell WINS over the value here, so
#     `export DATABASE_URL=...` overrides it without editing anything
DATABASE_URL=postgres://mac_resource_hub:mac_resource_hub@localhost:5433/mac_resource_hub
