# Copy these into the Dokploy environment UI (Application → Environment).
# Everything except POSTGRES_PASSWORD has a working default — the app boots
# without any of them set.

# ── Required in production ───────────────────────────────────────────────────
# The Postgres password. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# ── Routing ──────────────────────────────────────────────────────────────────
# Must be a *.monashcoding.com subdomain, or mac-auth sign-in will not work:
# its session cookie is scoped to .monashcoding.com.
APP_DOMAIN=resources.monashcoding.com

# ── mac-auth ─────────────────────────────────────────────────────────────────
# AUTH_URL is used by the server (JWKS verification); VITE_AUTH_URL is baked
# into the SPA bundle at BUILD time, so changing it needs a rebuild, not just a
# restart. Keep them the same.
AUTH_URL=https://auth.monashcoding.com
VITE_AUTH_URL=https://auth.monashcoding.com
JWT_AUDIENCE=mac-suite

# Which mac-auth roles may reach /admin.
MAC_ADMIN_ROLES=exec,committee
